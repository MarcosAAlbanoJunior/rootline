# gate: gofmt must be clean, then go vet and golangci-lint in the root, then golangci-lint in hook/ and demo-app/
# (same lint commands as the CI job `check`; build and tests are the default steps).
LINT_CMD='test -z "$(gofmt -l .)" && go vet ./... && golangci-lint run && (cd hook && GOWORK=off golangci-lint run) && (cd demo-app && GOWORK=off golangci-lint run)'
