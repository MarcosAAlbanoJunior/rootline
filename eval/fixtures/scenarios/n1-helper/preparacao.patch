new file mode 100644
index 0000000..7658c16
--- /dev/null
+++ b/demo-app/internal/receipts/repository.go
@@ -0,0 +1,42 @@
+// Package receipts is the demo-app's receipts feature: one receipt per order of a customer, with
+// the order's totals.
+package receipts
+
+import (
+	"context"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// Querier is the subset of pgxpool.Pool used by the repository.
+type Querier interface {
+	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
+}
+
+// Order is one row of the orders table.
+type Order struct {
+	ID         int64
+	CustomerID int64
+	PlacedAt   time.Time
+}
+
+// Repository reads a customer's orders from Postgres.
+type Repository struct {
+	db Querier
+}
+
+// NewRepository returns a Repository over db.
+func NewRepository(db Querier) *Repository {
+	return &Repository{db: db}
+}
+
+// OrdersByCustomer returns the customer's orders, oldest first.
+func (r *Repository) OrdersByCustomer(ctx context.Context, customerID int64) ([]Order, error) {
+	rows, err := r.db.Query(ctx,
+		`SELECT id, customer_id, placed_at FROM orders WHERE customer_id = $1 ORDER BY id`, customerID)
+	if err != nil {
+		return nil, err
+	}
+	return pgx.CollectRows(rows, pgx.RowToStructByPos[Order])
+}
diff --git a/demo-app/internal/receipts/service.go b/demo-app/internal/receipts/service.go
new file mode 100644
index 0000000..de3563a
--- /dev/null
+++ b/demo-app/internal/receipts/service.go
@@ -0,0 +1,56 @@
+package receipts
+
+import (
+	"context"
+	"time"
+)
+
+// Receipt is an order with its item count and quantity sum.
+type Receipt struct {
+	OrderID  int64     `json:"order_id"`
+	PlacedAt time.Time `json:"placed_at"`
+	Items    int64     `json:"items"`
+	Qty      int64     `json:"qty"`
+}
+
+// OrderStore is what the service needs to read orders.
+type OrderStore interface {
+	OrdersByCustomer(ctx context.Context, customerID int64) ([]Order, error)
+}
+
+// Pricer is what the service needs to total orders.
+type Pricer interface {
+	Totals(ctx context.Context, orderIDs []int64) (items, qty map[int64]int64, err error)
+}
+
+// Service builds the receipts of a customer.
+type Service struct {
+	orders OrderStore
+	pricer Pricer
+}
+
+// NewService returns a Service over orders and pricer.
+func NewService(orders OrderStore, pricer Pricer) *Service {
+	return &Service{orders: orders, pricer: pricer}
+}
+
+// Receipts returns one receipt per order of the customer, oldest first.
+func (s *Service) Receipts(ctx context.Context, customerID int64) ([]Receipt, error) {
+	list, err := s.orders.OrdersByCustomer(ctx, customerID)
+	if err != nil {
+		return nil, err
+	}
+	ids := make([]int64, 0, len(list))
+	for _, o := range list {
+		ids = append(ids, o.ID)
+	}
+	items, qty, err := s.pricer.Totals(ctx, ids)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Receipt, 0, len(list))
+	for _, o := range list {
+		out = append(out, Receipt{OrderID: o.ID, PlacedAt: o.PlacedAt, Items: items[o.ID], Qty: qty[o.ID]})
+	}
+	return out, nil
+}
