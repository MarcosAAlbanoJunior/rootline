+package pricing
+
+import "context"
+
+// Store is what the calculator needs from the repository.
+type Store interface {
+	TotalsByOrders(ctx context.Context, orderIDs []int64) (items, qty map[int64]int64, err error)
+}
+
+// Calculator computes order totals.
+type Calculator struct {
+	store Store
+}
+
+// NewCalculator returns a Calculator over store.
+func NewCalculator(store Store) *Calculator {
+	return &Calculator{store: store}
+}
+
+// Totals returns the item count and quantity sum of every given order, keyed by order id.
+func (c *Calculator) Totals(ctx context.Context, orderIDs []int64) (items, qty map[int64]int64, err error) {
+	return c.store.TotalsByOrders(ctx, orderIDs)
+}
diff --git a/demo-app/internal/pricing/repository.go b/demo-app/internal/pricing/repository.go
new file mode 100644
index 0000000..2fb4300
--- /dev/null
+++ b/demo-app/internal/pricing/repository.go
@@ -0,0 +1,48 @@
+// Package pricing is the demo-app's pricing: item count and quantity totals per order.
+package pricing
+
+import (
+	"context"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// Querier is the subset of pgxpool.Pool used by the repository.
+type Querier interface {
+	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
+}
+
+// Repository reads order totals from Postgres.
+type Repository struct {
+	db Querier
+}
+
+// NewRepository returns a Repository over db.
+func NewRepository(db Querier) *Repository {
+	return &Repository{db: db}
+}
+
+type totalRow struct {
+	OrderID int64
+	Items   int64
+	Qty     int64
+}
+
+// TotalsByOrders returns the item count and quantity sum of all given orders in a single query,
+// keyed by order id. An order without items is absent.
+func (r *Repository) TotalsByOrders(ctx context.Context, orderIDs []int64) (items, qty map[int64]int64, err error) {
+	rows, err := r.db.Query(ctx,
+		`SELECT order_id, count(*), sum(qty) FROM order_items WHERE order_id = ANY($1) GROUP BY order_id ORDER BY order_id`, orderIDs)
+	if err != nil {
+		return nil, nil, err
+	}
+	totals, err := pgx.CollectRows(rows, pgx.RowToStructByPos[totalRow])
+	if err != nil {
+		return nil, nil, err
+	}
+	items, qty = make(map[int64]int64, len(totals)), make(map[int64]int64, len(totals))
+	for _, t := range totals {
+		items[t.OrderID], qty[t.OrderID] = t.Items, t.Qty
+	}
+	return items, qty, nil
+}
diff --git a/demo-app/internal/receipts/handler.go b/demo-app/internal/receipts/handler.go
new file mode 100644
index 0000000..a114f5f
--- /dev/null
+++ b/demo-app/internal/receipts/handler.go
@@ -0,0 +1,45 @@
+package receipts
+
+import (
+	"context"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"strconv"
+)
+
+// Lister is what the handler needs from the service.
+type Lister interface {
+	Receipts(ctx context.Context, customerID int64) ([]Receipt, error)
+}
+
+// Handler serves the receipts HTTP endpoint.
+type Handler struct {
+	lister Lister
+}
+
+// NewHandler returns a Handler over lister.
+func NewHandler(lister Lister) *Handler {
+	return &Handler{lister: lister}
+}
+
+// Register mounts the route on mux.
+func (h *Handler) Register(mux *http.ServeMux) {
+	mux.HandleFunc("GET /customers/{id}/receipts", h.listReceipts)
+}
+
+func (h *Handler) listReceipts(w http.ResponseWriter, r *http.Request) {
+	id, err := strconv.ParseInt(r.PathValue("id"), 10, 64)
+	if err != nil {
+		http.Error(w, "invalid customer id", http.StatusBadRequest)
+		return
+	}
+	out, err := h.lister.Receipts(r.Context(), id)
+	if err != nil {
+		slog.Error("list receipts failed", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(out)
+}
