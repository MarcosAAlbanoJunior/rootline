diff --git a/demo-app/schema/100_activity.sql b/demo-app/schema/100_activity.sql
new file mode 100644
index 0000000..172d7ab
--- /dev/null
+++ b/demo-app/schema/100_activity.sql
@@ -0,0 +1,16 @@
+-- Activity: half a million events, 25 thousand per customer.
+CREATE TABLE IF NOT EXISTS events (
+    id          BIGINT PRIMARY KEY,
+    customer_id BIGINT NOT NULL REFERENCES customers (id),
+    kind        TEXT NOT NULL,
+    amount      INT NOT NULL,
+    occurred_at TIMESTAMPTZ NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS events_customer_id_idx ON events (customer_id);
+
+INSERT INTO events (id, customer_id, kind, amount, occurred_at)
+SELECT e, e % 20 + 1, (ARRAY['view', 'cart', 'purchase', 'refund'])[(e / 20) % 4 + 1], (e * 37) % 1000 + 1,
+       TIMESTAMPTZ '2025-01-01T00:00:00Z' + make_interval(secs => e * 60)
+FROM generate_series(1, 500000) AS e
+ON CONFLICT DO NOTHING;
