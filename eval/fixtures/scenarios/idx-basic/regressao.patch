+// LatestOrderID returns the id of the customer's most recent order.
+func (r *Repository) LatestOrderID(ctx context.Context, customerID int64) (int64, error) {
+	rows, err := r.db.Query(ctx, `SELECT id FROM orders WHERE customer_id = $1 ORDER BY id DESC LIMIT 1`, customerID)
+	if err != nil {
+		return 0, err
+	}
+	return pgx.CollectExactlyOneRow(rows, pgx.RowTo[int64])
+}
+
+// PaymentOfOrder returns the payments of one order.
+func (r *Repository) PaymentOfOrder(ctx context.Context, orderID int64) ([]Payment, error) {
+	rows, err := r.db.Query(ctx, `SELECT id, amount, status FROM payments WHERE order_id = $1`, orderID) // rootline:answer
+	if err != nil {
+		return nil, err
+	}
+	return pgx.CollectRows(rows, pgx.RowToStructByPos[Payment])
+}
+
 // LargePaymentsTotal sums every payment above threshold, across all customers.
 func (r *Repository) LargePaymentsTotal(ctx context.Context, threshold int) (int64, error) {
 	rows, err := r.db.Query(ctx, `SELECT coalesce(sum(amount), 0) FROM payments WHERE amount > $1`, threshold)
