diff --git a/demo-app/schema/100_payments.sql b/demo-app/schema/100_payments.sql
new file mode 100644
index 0000000..c8e8322
--- /dev/null
+++ b/demo-app/schema/100_payments.sql
@@ -0,0 +1,20 @@
+-- Payments: one per order, with a year of order history.
+CREATE TABLE IF NOT EXISTS payments (
+    id          BIGINT PRIMARY KEY,
+    customer_id BIGINT NOT NULL REFERENCES customers (id),
+    order_id    BIGINT NOT NULL REFERENCES orders (id),
+    amount      INT NOT NULL,
+    status      TEXT NOT NULL
+);
+
+CREATE INDEX IF NOT EXISTS payments_customer_id_idx ON payments (customer_id);
+
+INSERT INTO orders (id, customer_id, placed_at)
+SELECT o, o % 20 + 1, TIMESTAMPTZ '2026-01-01T00:00:00Z' + make_interval(mins => o)
+FROM generate_series(201, 50200) AS o
+ON CONFLICT DO NOTHING;
+
+INSERT INTO payments (id, customer_id, order_id, amount, status)
+SELECT o.id, o.customer_id, o.id, (o.id * 37) % 1000 + 1, (ARRAY['paid', 'pending', 'refunded'])[o.id % 3 + 1]
+FROM orders o
+ON CONFLICT DO NOTHING;
