--- /dev/null
+++ b/demo-app/internal/statement/repository.go
@@ -0,0 +1,43 @@
+// Package statement is the demo-app's customer statement: every item the customer bought.
+package statement
+
+import (
+	"context"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// Querier is the subset of pgxpool.Pool used by the repository.
+type Querier interface {
+	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
+}
+
+// Item is one row of the order_items table.
+type Item struct {
+	ID      int64  `json:"id"`
+	OrderID int64  `json:"order_id"`
+	SKU     string `json:"sku"`
+	Qty     int    `json:"qty"`
+}
+
+// Repository reads a customer's items from Postgres.
+type Repository struct {
+	db Querier
+}
+
+// NewRepository returns a Repository over db.
+func NewRepository(db Querier) *Repository {
+	return &Repository{db: db}
+}
+
+// ItemsPage returns up to pageSize items of the customer with an id greater than afterID, by id.
+// The LIMIT must match pageSize.
+func (r *Repository) ItemsPage(ctx context.Context, customerID, afterID int64) ([]Item, error) {
+	rows, err := r.db.Query(ctx,
+		`SELECT oi.id, oi.order_id, oi.sku, oi.qty FROM order_items oi JOIN orders o ON o.id = oi.order_id WHERE o.customer_id = $1 AND oi.id > $2 ORDER BY oi.id LIMIT 4`,
+		customerID, afterID)
+	if err != nil {
+		return nil, err
+	}
+	return pgx.CollectRows(rows, pgx.RowToStructByPos[Item])
+}
diff --git a/demo-app/internal/statement/service.go b/demo-app/internal/statement/service.go
new file mode 100644
index 0000000..946d9ee
--- /dev/null
+++ b/demo-app/internal/statement/service.go
@@ -0,0 +1,44 @@
+package statement
+
+import "context"
+
+// pageSize is the number of items per page of the keyset read.
+const pageSize = 4
+
+// Statement is every item a customer bought.
+type Statement struct {
+	Items []Item `json:"items"`
+}
+
+// Store is what the service needs from the repository.
+type Store interface {
+	ItemsPage(ctx context.Context, customerID, afterID int64) ([]Item, error)
+}
+
+// Service builds a customer's statement.
+type Service struct {
+	store Store
+}
+
+// NewService returns a Service over store.
+func NewService(store Store) *Service {
+	return &Service{store: store}
+}
+
+// Statement reads every item of the customer in pages, by keyset.
+func (s *Service) Statement(ctx context.Context, customerID int64) (Statement, error) {
+	var st Statement
+	var after int64
+	for {
+		page, err := s.store.ItemsPage(ctx, customerID, after) // rootline:distractor
+		if err != nil {
+			return Statement{}, err
+		}
+		st.Items = append(st.Items, page...)
+		if len(page) < pageSize {
+			break
+		}
+		after = page[len(page)-1].ID
+	}
+	return st, nil
+}
