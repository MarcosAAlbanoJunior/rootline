@@ -0,0 +1,45 @@
+package dashboard
+
+import (
+	"context"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"strconv"
+)
+
+// Builder is what the handler needs from the service.
+type Builder interface {
+	Dashboard(ctx context.Context, customerID int64) (Dashboard, error)
+}
+
+// Handler serves the customer dashboard HTTP endpoint.
+type Handler struct {
+	builder Builder
+}
+
+// NewHandler returns a Handler over builder.
+func NewHandler(builder Builder) *Handler {
+	return &Handler{builder: builder}
+}
+
+// Register mounts the route on mux.
+func (h *Handler) Register(mux *http.ServeMux) {
+	mux.HandleFunc("GET /customers/{id}/dashboard", h.getDashboard)
+}
+
+func (h *Handler) getDashboard(w http.ResponseWriter, r *http.Request) {
+	id, err := strconv.ParseInt(r.PathValue("id"), 10, 64)
+	if err != nil {
+		http.Error(w, "invalid customer id", http.StatusBadRequest)
+		return
+	}
+	out, err := h.builder.Dashboard(r.Context(), id)
+	if err != nil {
+		slog.Error("customer dashboard failed", "err", err)
+		http.Error(w, "internal error", http.StatusInternalServerError)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_ = json.NewEncoder(w).Encode(out)
+}
diff --git a/demo-app/internal/dashboard/repository.go b/demo-app/internal/dashboard/repository.go
new file mode 100644
index 0000000..7690cbb
--- /dev/null
+++ b/demo-app/internal/dashboard/repository.go
@@ -0,0 +1,53 @@
+// Package dashboard is the demo-app's customer dashboard: the most recent orders and the total
+// quantity ordered, read in parallel through the work pool.
+package dashboard
+
+import (
+	"context"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// Querier is the subset of pgxpool.Pool used by the repository.
+type Querier interface {
+	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
+	QueryRow(ctx context.Context, sql string, args ...any) pgx.Row
+}
+
+// Order is one row of the orders table.
+type Order struct {
+	ID         int64     `json:"id"`
+	CustomerID int64     `json:"customer_id"`
+	PlacedAt   time.Time `json:"placed_at"`
+}
+
+// Repository reads the dashboard data from Postgres.
+type Repository struct {
+	db Querier
+}
+
+// NewRepository returns a Repository over db.
+func NewRepository(db Querier) *Repository {
+	return &Repository{db: db}
+}
+
+// RecentOrders returns the customer's most recent orders, newest first, at most limit.
+func (r *Repository) RecentOrders(ctx context.Context, customerID int64, limit int) ([]Order, error) {
+	rows, err := r.db.Query(ctx,
+		`SELECT id, customer_id, placed_at FROM orders WHERE customer_id = $1 ORDER BY placed_at DESC LIMIT $2`,
+		customerID, limit)
+	if err != nil {
+		return nil, err
+	}
+	return pgx.CollectRows(rows, pgx.RowToStructByPos[Order])
+}
+
+// TotalQty returns the quantity of all items the customer ever ordered.
+func (r *Repository) TotalQty(ctx context.Context, customerID int64) (int64, error) {
+	var total int64
+	err := r.db.QueryRow(ctx,
+		`SELECT COALESCE(SUM(i.qty), 0) FROM order_items i JOIN orders o ON o.id = i.order_id WHERE o.customer_id = $1`,
+		customerID).Scan(&total)
+	return total, err
+}
diff --git a/demo-app/internal/dashboard/service.go b/demo-app/internal/dashboard/service.go
new file mode 100644
index 0000000..6af4b0d
--- /dev/null
+++ b/demo-app/internal/dashboard/service.go
@@ -0,0 +1,58 @@
+package dashboard
+
+import (
+	"context"
+
+	"github.com/MarcosAAlbanoJunior/rootline/demo-app/internal/workpool"
+)
+
+// recentLimit is how many recent orders the dashboard shows.
+const recentLimit = 5
+
+// Dashboard is the customer's most recent orders and the total quantity ordered.
+type Dashboard struct {
+	RecentOrders []Order `json:"recent_orders"`
+	TotalQty     int64   `json:"total_qty"`
+}
+
+// Store is what the service needs from the repository.
+type Store interface {
+	RecentOrders(ctx context.Context, customerID int64, limit int) ([]Order, error)
+	TotalQty(ctx context.Context, customerID int64) (int64, error)
+}
+
+// Pool is what the service needs from the work pool.
+type Pool interface {
+	Group(ctx context.Context) *workpool.Group
+}
+
+// Service builds a customer's dashboard.
+type Service struct {
+	store Store
+	pool  Pool
+}
+
+// NewService returns a Service over store, running its jobs on pool.
+func NewService(store Store, pool Pool) *Service {
+	return &Service{store: store, pool: pool}
+}
+
+// Dashboard reads the recent orders and the total quantity in two parallel jobs.
+func (s *Service) Dashboard(ctx context.Context, customerID int64) (Dashboard, error) {
+	var out Dashboard
+	g := s.pool.Group(ctx)
+	g.Go(func(ctx context.Context) error {
+		var err error
+		out.RecentOrders, err = s.store.RecentOrders(ctx, customerID, recentLimit)
+		return err
+	})
+	g.Go(func(ctx context.Context) error {
+		var err error
+		out.TotalQty, err = s.store.TotalQty(ctx, customerID)
+		return err
+	})
+	if err := g.Wait(); err != nil {
+		return Dashboard{}, err
+	}
+	return out, nil
+}
