@@ -0,0 +1,60 @@
+// Package shipments is the demo-app's shipments: a customer's orders with the items to ship, read
+// through the work pool.
+package shipments
+
+import (
+	"context"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+)
+
+// Querier is the subset of pgxpool.Pool used by the repository.
+type Querier interface {
+	Query(ctx context.Context, sql string, args ...any) (pgx.Rows, error)
+}
+
+// Order is one row of the orders table.
+type Order struct {
+	ID         int64     `json:"id"`
+	CustomerID int64     `json:"customer_id"`
+	PlacedAt   time.Time `json:"placed_at"`
+}
+
+// Item is one row of the order_items table.
+type Item struct {
+	ID      int64  `json:"id"`
+	OrderID int64  `json:"order_id"`
+	SKU     string `json:"sku"`
+	Qty     int    `json:"qty"`
+}
+
+// Repository reads orders and items from Postgres.
+type Repository struct {
+	db Querier
+}
+
+// NewRepository returns a Repository over db.
+func NewRepository(db Querier) *Repository {
+	return &Repository{db: db}
+}
+
+// Orders returns the customer's orders, oldest first.
+func (r *Repository) Orders(ctx context.Context, customerID int64) ([]Order, error) {
+	rows, err := r.db.Query(ctx,
+		`SELECT id, customer_id, placed_at FROM orders WHERE customer_id = $1 ORDER BY id`, customerID)
+	if err != nil {
+		return nil, err
+	}
+	return pgx.CollectRows(rows, pgx.RowToStructByPos[Order])
+}
+
+// ItemsByOrders returns the items of all given orders in a single query.
+func (r *Repository) ItemsByOrders(ctx context.Context, orderIDs []int64) ([]Item, error) {
+	rows, err := r.db.Query(ctx,
+		`SELECT id, order_id, sku, qty FROM order_items WHERE order_id = ANY($1) ORDER BY id`, orderIDs)
+	if err != nil {
+		return nil, err
+	}
+	return pgx.CollectRows(rows, pgx.RowToStructByPos[Item])
+}
diff --git a/demo-app/internal/shipments/service.go b/demo-app/internal/shipments/service.go
new file mode 100644
index 0000000..0c99a80
--- /dev/null
+++ b/demo-app/internal/shipments/service.go
@@ -0,0 +1,71 @@
+package shipments
+
+import (
+	"context"
+	"sync"
+
+	"github.com/MarcosAAlbanoJunior/rootline/demo-app/internal/workpool"
+)
+
+// Shipment is an order and the items to ship.
+type Shipment struct {
+	Order
+	Items []Item `json:"items"`
+}
+
+// Store is what the service needs from the repository.
+type Store interface {
+	Orders(ctx context.Context, customerID int64) ([]Order, error)
+	ItemsByOrders(ctx context.Context, orderIDs []int64) ([]Item, error)
+}
+
+// Pool is what the service needs from the work pool.
+type Pool interface {
+	Group(ctx context.Context) *workpool.Group
+}
+
+// Service builds a customer's shipments.
+type Service struct {
+	store Store
+	pool  Pool
+}
+
+// NewService returns a Service over store, running its jobs on pool.
+func NewService(store Store, pool Pool) *Service {
+	return &Service{store: store, pool: pool}
+}
+
+// Shipments returns the customer's orders, oldest first, each with its items.
+func (s *Service) Shipments(ctx context.Context, customerID int64) ([]Shipment, error) {
+	orders, err := s.store.Orders(ctx, customerID)
+	if err != nil {
+		return nil, err
+	}
+	g := s.pool.Group(ctx)
+	var mu sync.Mutex
+	byOrder := make(map[int64][]Item, len(orders))
+	g.Go(func(ctx context.Context) error {
+		ids := make([]int64, 0, len(orders))
+		for _, o := range orders {
+			ids = append(ids, o.ID)
+		}
+		items, err := s.store.ItemsByOrders(ctx, ids)
+		if err != nil {
+			return err
+		}
+		mu.Lock()
+		defer mu.Unlock()
+		for _, it := range items {
+			byOrder[it.OrderID] = append(byOrder[it.OrderID], it)
+		}
+		return nil
+	})
+	if err := g.Wait(); err != nil {
+		return nil, err
+	}
+	out := make([]Shipment, 0, len(orders))
+	for _, o := range orders {
+		out = append(out, Shipment{Order: o, Items: byOrder[o.ID]})
+	}
+	return out, nil
+}
diff --git a/demo-app/internal/workpool/pool.go b/demo-app/internal/workpool/pool.go
new file mode 100644
index 0000000..5b1993c
--- /dev/null
+++ b/demo-app/internal/workpool/pool.go
@@ -0,0 +1,94 @@
+// Package workpool is a long-lived pool of workers shared by the demo-app's requests. Each job runs
+// in its own span, child of the context of whoever submitted it.
+package workpool
+
+import (
+	"context"
+	"sync"
+
+	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/codes"
+)
+
+// SpanName is the name of the span every job runs in.
+const SpanName = "workpool.job"
+
+type task struct {
+	ctx  context.Context
+	fn   func(ctx context.Context) error
+	done func(err error)
+}
+
+// Pool runs submitted jobs on a fixed number of workers.
+type Pool struct {
+	jobs chan task
+	wg   sync.WaitGroup
+}
+
+// New starts a pool with the given number of workers. Close stops it.
+func New(workers int) *Pool {
+	p := &Pool{jobs: make(chan task)}
+	for range workers {
+		p.wg.Add(1)
+		go p.run()
+	}
+	return p
+}
+
+func (p *Pool) run() {
+	defer p.wg.Done()
+	tracer := otel.Tracer("github.com/MarcosAAlbanoJunior/rootline/demo-app/internal/workpool")
+	for job := range p.jobs {
+		ctx, span := tracer.Start(job.ctx, SpanName)
+		err := job.fn(ctx)
+		if err != nil {
+			span.RecordError(err)
+			span.SetStatus(codes.Error, err.Error())
+		}
+		span.End()
+		job.done(err)
+	}
+}
+
+// Close stops accepting jobs and waits for the workers to finish the running ones.
+func (p *Pool) Close() {
+	close(p.jobs)
+	p.wg.Wait()
+}
+
+// Group returns a group of jobs for one request; its jobs run under ctx.
+func (p *Pool) Group(ctx context.Context) *Group {
+	return &Group{pool: p, ctx: ctx}
+}
+
+// Group is a set of jobs submitted together, waited for with Wait.
+type Group struct {
+	pool *Pool
+	ctx  context.Context
+	wg   sync.WaitGroup
+	mu   sync.Mutex
+	err  error
+}
+
+// Go submits fn to the pool, blocking until a worker takes it.
+func (g *Group) Go(fn func(ctx context.Context) error) {
+	g.wg.Add(1)
+	g.pool.jobs <- task{ctx: g.ctx, fn: fn, done: g.finish}
+}
+
+func (g *Group) finish(err error) {
+	if err != nil {
+		g.mu.Lock()
+		if g.err == nil {
+			g.err = err
+		}
+		g.mu.Unlock()
+	}
+	g.wg.Done()
+}
+
+// Wait waits for every job of the group and returns the first error.
+func (g *Group) Wait() error {
+	g.wg.Wait()
+	return g.err
+}
